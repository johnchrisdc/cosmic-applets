[Desktop Entry]
Name=Potato Date, Time, & Calendar
Comment=Display the current time in words in the panel with a calendar popup
Type=Application
Exec=cosmic-applet-potato-time
Terminal=false
Categories=COSMIC;
Keywords=COSMIC;Applet;Date;Time;Calendar;Potato;
Icon=com.system76.CosmicAppletTime-symbolic
NoDisplay=true
X-CosmicApplet=true
X-CosmicShrinkable=true
X-HostWaylandDisplay=true
X-CosmicHoverPopup=Auto
